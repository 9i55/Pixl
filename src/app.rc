#include "version.hpp"
1 24 "app.manifest"
1 ICON "../res/pixl.ico"
201 RCDATA "../res/pixl.png"
202 RCDATA "../res/pixl-art.png"

1 VERSIONINFO
FILEVERSION     PIXL_VERSION_RC
PRODUCTVERSION  PIXL_VERSION_RC
FILEOS          0x40004L
FILETYPE        0x1L
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904b0"
    {
      VALUE "CompanyName",      "Pixl"
      VALUE "FileDescription",  "Pixl Audio Effects Console"
      VALUE "FileVersion",      PIXL_VERSION_STR
      VALUE "InternalName",     "Pixl"
      VALUE "LegalCopyright",   "Copyright (c) 2026 9i55"
      VALUE "LegalTrademarks",  "Pixl"
      VALUE "OriginalFilename", "Pixl.exe"
      VALUE "ProductName",      "Pixl"
      VALUE "ProductVersion",   PIXL_VERSION_STR
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x409, 1200
  }
}
